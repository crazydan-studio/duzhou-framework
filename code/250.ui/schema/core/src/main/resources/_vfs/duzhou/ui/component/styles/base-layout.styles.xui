<!-- [基础布局样式库]
> 针对组件布局的基础样式库。
-->
<styles xmlns:x="/nop/schema/xdsl.xdef"
        x:schema="/duzhou/ui/schema/styles.xdef"
        x:extends="base-common.styles.xui"
>

    <!-- [对齐模式]

    @row [行对齐模式]
        > 在行方向上的对齐模式。仅用于控制其朝向，其布局顺序不会变化，且不会发生重叠
    @column [列对齐模式]
        > 在列方向上的对齐模式。仅用于控制其朝向，其布局顺序不会变化，且不会发生重叠
    -->
    <align-base x:abstract="true"
                row="xui-align" column="xui-align"
    />
    <!-- [布局项自对齐模式]
    > 布局项自身在布局容器中的对齐模式，其将覆盖布局容器的 `<item-align/>` 所设置的缺省配置。
    >
    > 可应用于布局容器和纯粹的布局项。
    -->
    <self-align x:prototype="align-base" />
    <!-- [布局项对齐模式]
    > 用于配置布局项的缺省对齐模式，其可以被布局项的 `<self-align/>` 设置所覆盖。
    >
    > 仅应用于布局容器。
    -->
    <item-align x:prototype="align-base" />

    <!-- [布局项间间隔]
    > 控制行/列方向上的布局项之间的间隔。
    >
    > 仅应用于布局容器。

    @row [行间隔]
        > 在行方向上的布局项之间的间隔。
    @column [列间隔]
        > 在列方向上的布局项之间的间隔。
    -->
    <item-gap row="xui-align" column="xui-align" />

    <!-- [滚动条]
    > 配置滚动条颜色、大小以及滚动条何时显示，若不显示，则溢出内容将被隐藏。
    >
    > 滚动条均由布局节点控制，不管是文本还是其他组件，均不管滚动条，其尺寸始终为内容尺寸。

    @when [显示时机]
    @color [颜色]
    @size [大小]
    -->
    <scrollbar-base x:abstract="true" when="string" color="xui-color" size="xui-size" />
    <!-- [x 轴滚动条] -->
    <scrollbar-x x:prototype="scrollbar-base" />
    <!-- [y 轴滚动条] -->
    <scrollbar-y x:prototype="scrollbar-base" />
    <!-- [x 轴与 y 轴滚动条] -->
    <scrollbar x:prototype="scrollbar-base">
        <scrollbar-x when="${when}" color="${color}" size="${size}" />
        <scrollbar-y when="${when}" color="${color}" size="${size}" />
    </scrollbar>
</styles>
