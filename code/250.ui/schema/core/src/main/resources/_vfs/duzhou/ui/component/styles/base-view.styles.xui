<!-- [基础视觉样式库]
> 针对组件部件的基础样式库。
-->
<styles xmlns:x="/nop/schema/xdsl.xdef" xmlns:xui="xui"
        x:schema="/duzhou/ui/schema/styles.xdef"
        x:extends="base-common.styles.xui"
>

    <!-- [边框]

    @color [颜色]
    @size [尺寸]
    @style [样式]
    -->
    <border-base x:abstract="true"
                 color="xui-color" size="xui-size" style="xui-border-style"
    />
    <!-- [左边框] -->
    <border-left x:prototype="border-base" />
    <!-- [右边框] -->
    <border-right x:prototype="border-base" />
    <!-- [上边框] -->
    <border-top x:prototype="border-base" />
    <!-- [下边框] -->
    <border-bottom x:prototype="border-base" />
    <!-- 用于统一配置上/下/左/右四条边框的样式 -->
    <border x:prototype="border-base">
        <border-left color="${color}" size="${size}" style="${style}" />
        <border-right color="${color}" size="${size}" style="${style}" />
        <border-top color="${color}" size="${size}" style="${style}" />
        <border-bottom color="${color}" size="${size}" style="${style}" />
    </border>

    <!-- [阴影]
    > 可通过 `xui:alias` 重复该配置，以实现多重阴影效果，如：
    > ```xml
    > <button>
    >   <box-shadow-1 xui:alias="box-shadow" .../>
    >   <box-shadow-2 xui:alias="box-shadow" .../>
    > </button>
    > ```

    @offsetX [水平偏移]
        > 为正值时，向右偏移，为负值时，向左偏移
    @offsetY [垂直偏移]
        > 为正值时，向下偏移，为负值时，向上偏移
    @blurRadius [模糊半径]
        > 值越大越模糊
    @color [阴影颜色]
    -->
    <shadow-base x:abstract="true" xui:multiple="true"
                 offsetX="xui-size" offsetY="xui-size"
                 blurRadius="xui-size"
                 color="xui-color"
    />
    <!-- [文字阴影] -->
    <text-shadow x:prototype="shadow-base" />
    <!-- [盒子阴影]

    @inset [阴影方向]
        > 为 `true` 时，表示内阴影，否则均为外阴影
    @spreadRadius [扩展半径]
        > 为正值时，扩大半径，为负值时，缩小半径
    -->
    <box-shadow x:prototype="shadow-base"
                inset="boolean"
                spreadRadius="xui-size"
    />
    <!-- [投影]
    > 针对元素的实际形状（包括透明部分），不支持多重阴影。
    -->
    <drop-shadow x:prototype="shadow-base"
                 xui:multiple="false"
    />
</styles>
