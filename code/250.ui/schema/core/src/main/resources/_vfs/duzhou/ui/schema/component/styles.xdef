<!-- [组件样式]
>
-->
<styles xmlns:x="/nop/schema/xdsl.xdef" xmlns:xdef="/nop/schema/xdef.xdef" xmlns:xui="xui"
        x:schema="/nop/schema/xdef.xdef"
        xdef:bean-package="io.crazydan.duzhou.framework.ui.schema.component.style"
        xdef:name="XuiComponentStyles"
        xdef:body-type="map"
        xdef:bean-body-prop="children" xdef:bean-child-name="child"
        xdef:bean-body-type="List&lt;io.crazydan.duzhou.framework.ui.schema.style.XuiStyle>"
        xdef:bean-sub-type-prop="$tag"
>

    <!-- [组件根样式]
    > 特定作用于组件根节点的样式，其与样式只能作用于组件中指定的部件上。
    -->
    <root xdef:name="XuiComponentStyleRoot"
          xdef:ref="../style/style-def.xdef"
          xui:multiple="~boolean"
    />

    <!-- [组件部件样式]
    >
    > 标签名为 `layout__xxx` 形式的样式将被视为布局样式，仅可在布局节点中应用，且仅引用
    > `xxx` 部分所代表的名字，如 `<styles> <xxx .../> </styles>`。
    > 而 `xxx__hover`、`xxx__focus` 等形式的样式则会被视为针对组件部件的
    > `hover`、`focus` 等状态所应用的样式，其中 `xxx` 部分代表的是组件部件的一般样式的名字，
    > 如 `header` 部件所应用的样式 `<styles> <header .../> <header__hover .../> </styles>`。
    -->
    <xdef:unknown-tag xdef:name="XuiComponentStyleAny"
                      xdef:ref="../style/style-def.xdef"
                      xui:multiple="~boolean"
    />
</styles>
