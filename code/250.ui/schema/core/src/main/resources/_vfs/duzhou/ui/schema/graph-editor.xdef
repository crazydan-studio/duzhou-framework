<!-- [图编辑器]
> 通用的、有关节点和连线的图编辑器。
>
-->
<graph-editor xmlns:x="/nop/schema/xdsl.xdef" xmlns:xdef="/nop/schema/xdef.xdef"
              x:schema="/nop/schema/xdef.xdef"
>
    <nodes xdef:body-type="list" xdef:key-attr="id">
        <node id="!ns-name"
              x="float" y="float"
              width="float" height="float"
              label="string"
        >
            <props>
                <!-- []

                @primary [是否为主要属性]
                    > 主要属性将直接显示在节点中，其余属性则只会出现在节点的配置界面中
                -->
                <prop name="!var-name" displayName="string"
                      stdDomain="!std-domain" primary="!boolean"
                />
            </props>
        </node>
    </nodes>

    <edges xdef:body-type="list" xdef:key-attr="id">
        <edge id="!ns-name">
        </edge>
    </edges>
</graph-editor>
