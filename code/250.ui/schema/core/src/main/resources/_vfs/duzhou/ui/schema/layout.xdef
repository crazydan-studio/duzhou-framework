<!-- [布局控制]
> - 布局将影响运行时的节点嵌套关系，从而保证布局的准确性；
> - 一般可将布局根节点的高宽均设置为 `match-parent`，从而支持通过上层组件控制其实际尺寸；
> - TODO 各类布局均可嵌套其他布局类型；
-->
<layout xmlns:x="/nop/schema/xdsl.xdef" xmlns:xdef="/nop/schema/xdef.xdef" xmlns:xui="xui"
        x:schema="/nop/schema/xdef.xdef" xdef:check-ns="xui"
        xdef:bean-package="io.crazydan.duzhou.framework.ui.schema.layout"
        xdef:name="XuiLayout"
        xdef:ref="XuiLayoutNode"
        xui:name="!~ns-name=xui-layout-root-node"
>

    <xdef:define xdef:name="XuiLayoutNode"
                 xdef:ref="XuiLayoutNodeNamed"
                 xdef:body-type="list" xdef:key-attr="xui:name"
                 xdef:bean-body-prop="children" xdef:bean-child-name="child"
                 xdef:bean-body-type="List&lt;io.crazydan.duzhou.framework.ui.schema.layout.XuiLayoutNodeNamed>"
                 xdef:bean-sub-type-prop="$tag"
    >
        <!-- [线性布局]
        > 在行/列方向上进行布局控制，与
        > [css flexbox](https://css-tricks.com/snippets/css/a-guide-to-flexbox/)
        > 类似。
        -->
        <linear xdef:ref="XuiLayoutNodeLinear"
                xui:name="!ns-name=default"
        />

        <!-- [条件选择] -->
        <choose xdef:name="XuiLayoutNodeStatementChoose"
                xdef:ref="XuiLayoutNodeNamed"
                xdef:body-type="list" xdef:key-attr="xui:name"
                xdef:bean-body-prop="children" xdef:bean-child-name="child"
                xdef:bean-body-type="List&lt;io.crazydan.duzhou.framework.ui.schema.layout.XuiLayoutNodeNamed>"
                xdef:bean-sub-type-prop="$tag"
                xui:name="!ns-name"
        >
            <!-- [特定条件]

            @xui:name [唯一标识]
                > 在父节点内，该标识必须唯一
            @test [条件表达式]
                > 如 `${name != null}`。若其结果为 `true` 则获得其子节点
            -->
            <when xdef:name="XuiLayoutNodeStatementChooseWhen"
                  xdef:ref="XuiLayoutNode"
                  xui:name="!ns-name"
                  test="string"
            />
            <!-- [缺省条件] -->
            <otherwise xdef:name="XuiLayoutNodeStatementChooseOtherwise"
                       xdef:ref="XuiLayoutNode"
                       xui:name="!ns-name=otherwise"
            />
        </choose>
    </xdef:define>

    <!-- [线性布局节点]

    @type [布局类型]
        > 指定其内部子节点的布局方式
    @wrap [是否可换行]
        > 若为 `false`，则溢出节点将被隐藏，否则，溢出节点将自动换行显示。缺省为 `false`
    -->
    <xdef:define xdef:name="XuiLayoutNodeLinear"
                 xdef:ref="XuiLayoutNodeLayered"
                 type="!enum:io.crazydan.duzhou.framework.ui.schema.layout.XuiLayoutNodeLinear.Type"
                 wrap="boolean=false"
    >
        <!-- [子节点] -->
        <body xdef:body-type="list" xdef:key-attr="xui:name"
              xdef:bean-prop="children" xdef:bean-child-name="child"
              xdef:bean-body-type="List&lt;io.crazydan.duzhou.framework.ui.schema.layout.XuiLayoutNodeNamed>"
              xdef:bean-sub-type-prop="$tag"
        >
            <!-- [布局项]
            > - 布局项本身也是**布局节点**，但其不可嵌套其他布局节点，其为布局树的终点；
            > - 布局项所对应的是确定的**待布局目标**，比如组件；
            > - 通过 `pattern` 其可以匹配多个待布局目标，且这些目标拥有相同的布局配置，
            >   一般用于布局 `<for/>` 循环产生的节点；
            > - 若 `pattern` 未匹配到任何待布局目标，则该布局项将被视为不存在，其不影响其他布局节点；
            > - 若某个/某些待布局目标没有被任何布局项匹配，则其不参与布局，也不存在于 UI 树中；

            @pattern [匹配规则]
                > 用于匹配待布局目标唯一名字 `xui:name` 的**正则表达式**
            @keep-state [保持状态]
                > 在不同布局层中引用相同布局项时，通过该配置指定是否保持其状态
            -->
            <item xdef:name="XuiLayoutNodeLinearItem"
                  xdef:ref="XuiLayoutNodeStyled"
                  xui:name="!ns-name"
                  pattern="!regex" keep-state="boolean"
            />

            <linear xdef:ref="XuiLayoutNodeLinear"
                    xui:name="!ns-name"
                    layer="!~int"
            />
        </body>
    </xdef:define>

    <!-- [布局命名节点]

    @xui:name [唯一标识]
        > 在父节点内，该标识必须唯一
    -->
    <xdef:define xdef:name="XuiLayoutNodeNamed"
                 xdef:bean-implements-types="io.crazydan.duzhou.framework.ui.XuiNamed"
                 xdef:bean-tag-prop="$tag"
                 xui:name="!ns-name"
    />

    <!-- [支持样式配置的布局节点] -->
    <xdef:define xdef:name="XuiLayoutNodeStyled"
                 xdef:ref="XuiLayoutNodeNamed"
    >
        <!-- [布局样式] -->
        <styles xdef:ref="XuiLayoutNodeStyles" />
    </xdef:define>

    <!-- [分层的布局节点]
    > 通过 `layer` 指定布局节点在 z 轴上的位置，从而实现不同布局层之间的堆叠效果。

    @layer [层序号]
        > 布局节点在 z 轴上的序号，该值越大，则其越靠近顶层。
        > 不同布局层间的层序号可以相同，其将按声明顺序在同一层呈现
    -->
    <xdef:define xdef:name="XuiLayoutNodeLayered"
                 xdef:ref="XuiLayoutNodeStyled"
                 layer="!int=0"
    />

    <!-- [样式引用]
    > 引用在当前组件 `<styles/>` 中所定义的**布局样式**（名字以 `layout__` 开头的标签），
    > 其子节点标签名必须与去掉 `layout__` 后的样式名一致，且只能配置在该样式上所声明的属性。
    > 此类样式可以在上层组件中作为部件样式被定制修改。
    >
    > 也支持直接引用在组件的 `<styles/>` 标签上设置的 `layout` 属性所指向的布局样式库中定义的布局样式，
    > 但是，引用的此类样式将不能在上层组件中被定制修改。
    >
    > 注意，第一种引用样式的优先级高于第二种引用样式。
    -->
    <xdef:define xdef:name="XuiLayoutNodeStyles"
                 xdef:ref="style/style-refs.xdef"
    />
</layout>
