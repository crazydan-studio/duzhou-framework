<!-- [布局控制]
> - 布局将影响运行时的节点嵌套关系，从而保证布局的准确性；
> - 一般可将布局根节点的高宽均设置为 `match-parent`，从而支持通过上层组件控制其实际尺寸；
-->
<layout xmlns:x="/nop/schema/xdsl.xdef" xmlns:xdef="/nop/schema/xdef.xdef" xmlns:xui="xui"
        x:schema="/nop/schema/xdef.xdef" xdef:check-ns="xui"
        xdef:bean-package="io.crazydan.duzhou.framework.ui.schema.layout"
        xdef:ref="XuiLayout"
>

    <xdef:define xdef:name="XuiLayout"
                 xdef:bean-implements-types="io.crazydan.duzhou.framework.ui.XuiNamed"
                 xdef:body-type="union"
                 xdef:bean-body-type="io.crazydan.duzhou.framework.ui.schema.layout.XuiLayoutRoot"
                 xdef:bean-body-prop="root"
                 xdef:bean-sub-type-prop="$tag"
    >
        <!-- [线性布局]
        > 在行/列方向上进行布局控制，与
        > [css flexbox](https://css-tricks.com/snippets/css/a-guide-to-flexbox/)
        > 类似。
        -->
        <linear xdef:name="XuiLayoutLinear"
                xdef:ref="XuiLayoutLinearNode"
                xdef:bean-implements-types="io.crazydan.duzhou.framework.ui.schema.layout.XuiLayoutRoot"
                xui:name="~ns-name=xui-layout-root-node"
        />

        <!-- [堆叠布局]
        > 在 z 轴上对**待布局目标**进行布局。
        > 若某层涉及复杂布局，则需要将该层组件全部放在同一个容器组件节点中，
        > 再对该容器组件与其他兄弟节点做堆叠布局。
        > TODO 考虑在其内部可嵌入 linear 等布局，以避免使用不必要的容器组件
        -->
        <stacked xdef:name="XuiLayoutStacked"
                 xdef:ref="XuiLayoutNodeStyled"
                 xdef:bean-tag-prop="$tag"
                 xdef:bean-implements-types="io.crazydan.duzhou.framework.ui.schema.layout.XuiLayoutRoot"
        >
            <body xdef:body-type="list" xdef:key-attr="xui:name"
                  xdef:bean-prop="children" xdef:bean-child-name="child"
                  xdef:bean-body-type="List&lt;io.crazydan.duzhou.framework.ui.schema.layout.XuiLayoutStackedItem>"
                  xdef:bean-sub-type-prop="$tag"
            >
                <!-- [布局项]

                @target [待布局目标]
                    > 对应目标的 `xui:name`
                @layer [层序号]
                    > 布局项所处在的 z 轴位置。该值越大，则布局项在 UI 层面越靠近上层。
                    > 不同层的层序号不能相同，但可以不相邻
                -->
                <item xdef:name="XuiLayoutStackedItem"
                      xdef:ref="XuiLayoutNodeNamed"
                      xdef:bean-tag-prop="$tag"
                      xui:name="!ns-name"
                      target="!ns-name" layer="!int"
                />
            </body>
        </stacked>

        <!-- [条件选择] -->
        <choose xdef:name="XuiLayoutStatementChoose"
                xdef:bean-tag-prop="$tag"
                xdef:bean-implements-types="io.crazydan.duzhou.framework.ui.schema.layout.XuiLayoutRoot"
                xdef:body-type="list" xdef:key-attr="xui:name"
                xdef:bean-body-prop="children" xdef:bean-child-name="child"
                xdef:bean-body-type="List&lt;io.crazydan.duzhou.framework.ui.schema.layout.XuiLayout>"
                xdef:bean-sub-type-prop="$tag"
        >
            <!-- [特定条件]

            @xui:name [唯一标识]
                > 在父节点内，该标识必须唯一
            @test [条件表达式]
                > 如 `${name != null}`。若其结果为 `true` 则获得其子节点
            -->
            <when xdef:name="XuiLayoutStatementChooseWhen"
                  xdef:ref="XuiLayout"
                  xui:name="!ns-name"
                  test="string"
            />
            <!-- [缺省条件] -->
            <otherwise xdef:name="XuiLayoutStatementChooseOtherwise"
                       xdef:ref="XuiLayout"
                       xui:name="!ns-name=otherwise"
            />
        </choose>
    </xdef:define>

    <!-- [线性布局节点]

    @type [布局类型]
        > 指定其内部子节点的布局方式
    @wrap [是否可换行]
        > 若为 `false`，则溢出节点将被隐藏，否则，溢出节点将自动换行显式。缺省为 `false`
    -->
    <xdef:define xdef:name="XuiLayoutLinearNode"
                 xdef:ref="XuiLayoutNodeNamed"
                 xdef:bean-tag-prop="$tag"
                 type="!enum:io.crazydan.duzhou.framework.ui.schema.layout.XuiLayoutLinearNode.Type"
                 wrap="boolean"
    >
        <!-- [子节点] -->
        <body xdef:body-type="list" xdef:key-attr="xui:name"
              xdef:bean-prop="children" xdef:bean-child-name="child"
              xdef:bean-body-type="List&lt;io.crazydan.duzhou.framework.ui.schema.layout.XuiLayoutNodeNamed>"
              xdef:bean-sub-type-prop="$tag"
        >
            <!-- [布局项]
            > - 布局项本身也是**布局节点**，但其不可嵌套其他布局节点，其为布局树的终点；
            > - 布局项所对应的是确定的**待布局目标**，比如组件；
            > - 通过 `pattern` 其可以匹配多个待布局目标，且这些目标拥有相同的布局配置，
            >   一般用于布局 `<for/>` 循环产生的节点；
            > - 若 `pattern` 未匹配到任何待布局目标，则该布局项将被视为不存在，其不影响其他布局节点；
            > - 若某个/某些待布局目标没有被任何布局项匹配，则其不参与布局，也不存在于 UI 树中；

            @pattern [匹配规则]
                > 用于匹配待布局目标唯一名字 `xui:name` 的**正则表达式**
            -->
            <item xdef:name="XuiLayoutLinearItem"
                  xdef:ref="XuiLayoutNodeNamed"
                  xdef:bean-tag-prop="$tag"
                  xui:name="!ns-name"
                  pattern="!regex"
            />

            <node xdef:ref="XuiLayoutLinearNode"
                  xui:name="!ns-name"
            />
        </body>
    </xdef:define>

    <!-- [布局命名节点]

    @xui:name [唯一标识]
        > 在父节点内，该标识必须唯一
    -->
    <xdef:define xdef:name="XuiLayoutNodeNamed"
                 xdef:ref="XuiLayoutNodeStyled"
                 xdef:bean-implements-types="io.crazydan.duzhou.framework.ui.XuiNamed"
                 xui:name="!ns-name"
    />

    <xdef:define xdef:name="XuiLayoutNodeStyled">
        <!-- [布局样式] -->
        <styles xdef:ref="XuiLayoutNodeStyles" />
    </xdef:define>

    <!-- [样式引用]
    > 引用在当前组件 `<styles/>` 中所定义的**布局样式**（名字以 `layout__` 开头的标签），
    > 其子节点标签名必须与去掉 `layout__` 后的样式名一致，且只能配置在该样式上所声明的属性。
    > 此类样式可以在上层组件中作为部件样式被定制修改。
    >
    > 也支持直接引用在组件的 `<styles/>` 标签上设置的 `layout` 属性所指向的布局样式库中定义的布局样式，
    > 但是，引用的此类样式将不能在上层组件中被定制修改。
    >
    > 注意，第一种引用样式的优先级高于第二种引用样式。
    -->
    <xdef:define xdef:name="XuiLayoutNodeStyles"
                 xdef:ref="style/style-refs.xdef"
    />
</layout>
