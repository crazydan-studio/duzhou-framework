<!-- [For 循环]
>

@var [循环元素的变量名]
    > 如 `user`
@index [循环元素序号的变量名]
    > 如 `idx`

@items [待循环变量]
    > 列表类型的变量，依次遍历其中的元素，如 `${props.users}`

@begin [循环起始值]
    > 按数值循环时的初始值，如 `0`
@end [循环结束值]
    > 按数值循环时的结束值，如 `10`
@step [循环步进值]
    > 按数值循环时的步进值，如 `2`
-->
<for xmlns:x="/nop/schema/xdsl.xdef"
     x:schema="/nop/schema/xdef.xdef"
     var="!var-name" index="var-name"
     items="string"
     begin="int" end="int" step="int=1"
/>
