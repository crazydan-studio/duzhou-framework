<component xmlns:x="/nop/schema/xdsl.xdef" xmlns:xui="xui"
           x:schema="/duzhou/ui/schema/component.xdef"
>
    <import as="Text" from="/duzhou/ui/component/text.xui" />

    <template>
        <layout>
            <linear type="column">
                <body>
                    <item xui:name="item-1" pattern="text-1">
                        <props>
                            <padding all="${props.padding}" />
                        </props>
                    </item>
                </body>
            </linear>
        </layout>

        <body>
            <Text xui:name="text-1"><![CDATA[
                Text: ${props.msg}
            ]]></Text>
        </body>
    </template>
</component>
