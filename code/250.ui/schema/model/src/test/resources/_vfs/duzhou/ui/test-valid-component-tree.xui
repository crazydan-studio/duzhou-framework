<component xmlns:x="/nop/schema/xdsl.xdef" xmlns:xui="xui"
           x:schema="/duzhou/ui/schema/component.xdef"
>
    <import as="Button" from="/duzhou/ui/component/button.xui" />

    <template>
        <layout>
            <linear xui:name="layer-1" type="column">
                <body>
                    <item xui:name="item-1" pattern=".+" />
                </body>
            </linear>
        </layout>

        <body>
            <text xui:name="text-1">
                <body><![CDATA[
                    Text 1
                ]]></body>
            </text>

            <native xui:name="native-1" name="box" style="border: 1u;">
                <body>
                    <text xui:name="text-1">
                        <body>Native Text</body>
                    </text>
                </body>
            </native>

            <slot xui:name="slot-1">
                <body>
                    <if xui:name="if-1" test="${a == 1}">
                        <text xui:name="text-1">
                            <body>If 1 Text 1</body>
                        </text>
                    </if>
                    <text xui:name="text-1">
                        <body>Text 1</body>
                    </text>
                </body>
            </slot>

            <for xui:name="for-1" begin="0" end="2" var="i">
                <text xui:name="text-1">
                    <body>For 1 Text 1</body>
                </text>
                <native xui:name="native-1" name="box">
                    <body>
                        <text xui:name="text-1">
                            <body>Text 1</body>
                        </text>
                        <native xui:name="native-1" name="text" />
                        <text xui:name="text-2">
                            <body>Text 2</body>
                        </text>
                    </body>
                </native>
                <text xui:name="text-2">
                    <body>For 1 Text 2</body>
                </text>
            </for>

            <Button xui:name="button-1" style="background-color: white;">
                <dispatch msg="User_Update" events="click" />

                <body>
                    <text xui:name="text-1">
                        <body>Text 1</body>
                    </text>
                    <native xui:name="native-1" name="text" />
                    <text xui:name="text-2">
                        <body>Text 2</body>
                    </text>
                </body>
            </Button>

            <if xui:name="if-1" test="${b == 1}">
                <text xui:name="text-1">
                    <body><![CDATA[
                        Hello!
                    ]]></body>
                </text>
            </if>
            <choose xui:name="choose-1">
                <when xui:name="when-1" test="${when == 1}">
                    <text xui:name="text-1">
                        <body>When #1</body>
                    </text>
                </when>
                <when xui:name="when-2" test="${when == 2}">
                    <text xui:name="text-1">
                        <body>When #2</body>
                    </text>
                    <Button xui:name="button-1" />
                </when>
                <otherwise>
                    <Button xui:name="button-1">
                        <body>
                            <text xui:name="text-1">
                                <body>Otherwise</body>
                            </text>
                        </body>
                    </Button>
                </otherwise>
            </choose>
        </body>
    </template>
</component>
