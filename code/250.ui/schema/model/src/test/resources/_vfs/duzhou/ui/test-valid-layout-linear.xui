<component xmlns:x="/nop/schema/xdsl.xdef" xmlns:xui="xui"
           x:schema="/duzhou/ui/schema/component.xdef"
>
    <template>
        <layout>
            <linear type="column">
                <props>
                    <width type="match-parent" />
                    <height type="match-parent" />
                    <padding row="1u" column="2u" />

                    <node-gap row="1u" column="2u" />
                </props>

                <body>
                    <node xui:name="node-1" type="row">
                        <props>
                            <width type="match-parent" />
                            <height type="wrap-content" />

                            <node-gap row="2u" />
                        </props>

                        <body>
                            <item xui:name="item-1" pattern="a1">
                                <props>
                                    <self-align row="start" column="end" />
                                </props>
                            </item>
                            <item xui:name="item-2" pattern="a2">
                                <props>
                                    <self-align row="center" column="center" />
                                </props>
                            </item>
                            <item xui:name="item-3" pattern="a3">
                                <props>
                                    <self-align row="end" column="start" />
                                </props>
                            </item>
                        </body>
                    </node>

                    <node xui:name="node-2" type="column">
                        <props>
                            <width type="wrap-content" />
                            <height type="value-specified" value="20u" />
                            <self-align row="center" />
                        </props>

                        <body>
                            <node xui:name="node-1" type="row">
                                <props>
                                    <width type="match-parent" />
                                </props>

                                <body>
                                    <item xui:name="item-1" pattern="b1-.+" />
                                    <item xui:name="item-2" pattern="b2-[\d]+" />
                                </body>
                            </node>
                            <node xui:name="node-2" type="column">
                                <props>
                                    <width type="match-parent" />
                                    <height type="fill-remains" />
                                </props>

                                <body>
                                    <item xui:name="item-1" pattern="c1-1" />
                                    <item xui:name="item-2" pattern="c1-2" />
                                </body>
                            </node>
                        </body>
                    </node>

                    <node xui:name="node-3" type="row">
                        <props>
                            <width type="match-parent" />
                            <height type="fill-remains" />

                            <node-align column="center" />
                        </props>

                        <body>
                            <item xui:name="item-1" pattern="d1-1">
                                <props>
                                    <self-align row="start" />
                                </props>
                            </item>
                            <item xui:name="item-2" pattern="d1-2-.+">
                                <props>
                                    <self-align row="end" />
                                </props>
                            </item>
                        </body>
                    </node>
                </body>
            </linear>
        </layout>
    </template>
</component>
