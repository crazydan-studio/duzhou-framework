<component xmlns:x="/nop/schema/xdsl.xdef" xmlns:xui="xui"
           x:schema="/duzhou/ui/schema/component.xdef"
>
    <template>
        <layout>
            <stacked>
                <props>
                    <width type="match-parent" />
                    <height type="match-parent" />
                    <padding all="2u" />
                </props>

                <body>
                    <item xui:name="item-1" target="box-1" layer="0" />
                    <item xui:name="item-2" target="box-2" layer="10">
                        <props>
                            <height type="value-specified" value="10u" />
                        </props>
                    </item>
                    <item xui:name="item-3" target="box-3" layer="20">
                        <props>
                            <width type="match-parent" />
                            <height type="match-parent" />
                        </props>
                    </item>
                </body>
            </stacked>
        </layout>
    </template>
</component>
